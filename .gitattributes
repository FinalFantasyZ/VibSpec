# 批处理文件必须保持 CRLF + UTF-8 BOM，否则 cmd.exe 逐字节解析会失败
# （报错形如 "'cho' 不是内部或外部命令"，详见 README 第八章）
*.bat text eol=crlf
*.cmd text eol=crlf

# 其余文本文件统一 LF
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文件不参与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.pdf binary
*.mat binary
*.csv binary
